.cats {
  white-space: nowrap;
  padding: 28rpx 24rpx 10rpx;
  background-color: #F7F5F2;
}

.cat {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  margin: 0 8rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  border: 1px solid #EAE4DB;
}

.cat-on {
  background-color: #B54A34;
  border-color: #B54A34;
}

.cat-name {
  font-size: 27rpx;
  color: #4A5158;
}

.cat-on .cat-name {
  color: #FFFFFF;
}

.cat-count {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #A9A199;
}

.cat-on .cat-count {
  color: rgba(255, 255, 255, 0.75);
}

.cat-head {
  display: flex;
  align-items: baseline;
  padding: 26rpx 40rpx 6rpx;
}

.cat-head-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2328;
  font-family: "Songti SC", "SimSun", Georgia, serif;
}

.cat-head-num {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: #A6ADA8;
}

/* 分类封面：与网页端分类页顶图一致 */
.cat-cover {
  position: relative;
  height: 330rpx;
  margin: 20rpx 24rpx 4rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #E9E4DC;
}

.cat-cover-img {
  display: block;
  width: 100%;
  height: 100%;
}

.cat-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
}

.cat-cover-name {
  position: absolute;
  left: 30rpx;
  bottom: 26rpx;
  right: 30rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  font-family: "Songti SC", "SimSun", Georgia, serif;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list {
  padding: 16rpx 32rpx 0;
}
