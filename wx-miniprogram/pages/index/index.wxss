.hero {
  padding: 44rpx 40rpx 8rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: #1F2328;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7278;
}

.hero-count {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #A6ADA8;
  letter-spacing: 1rpx;
}

.search-wrap {
  padding: 28rpx 32rpx 24rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #EFEAE2;
  border-radius: 999rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #9BA1A8;
  margin-right: 12rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #1F2328;
  height: 76rpx;
}

.search-ph {
  color: #A9A199;
}

.search-clear {
  font-size: 24rpx;
  color: #B54A34;
  padding-left: 16rpx;
}

.list {
  padding: 0 32rpx;
}

/* ---------- 轮播幻灯片（内容引用网页端首页轮播） ---------- */
.slider {
  height: 340rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #E9E4DC;
}

.slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.slide-img {
  display: block;
  width: 100%;
  height: 100%;
}

.slide-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
}

.slide-label {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  color: #1F2328;
  font-size: 23rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.slide-body {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 26rpx;
  color: #FFFFFF;
}

.slide-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slide-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
  opacity: 0.92;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
