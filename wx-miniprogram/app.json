{
  "pages": [
    "pages/index/index",
    "pages/category/category",
    "pages/about/about",
    "pages/mine/mine"
  ],
  "subpackages": [
    {
      "root": "packagePost",
      "name": "article",
      "pages": [
        "pages/detail/detail",
        "pages/archive/archive"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["article"]
    },
    "pages/category/category": {
      "network": "all",
      "packages": ["article"]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#F7F5F2",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "我的博客",
    "backgroundColor": "#F7F5F2",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9BA1A8",
    "selectedColor": "#B54A34",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "文章" },
      { "pagePath": "pages/category/category", "text": "分类" },
      { "pagePath": "pages/about/about", "text": "关于" },
      { "pagePath": "pages/mine/mine", "text": "我的" }
    ]
  },
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
