/* ---------- 骨架屏 ---------- */
.sk {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.sk-line {
  height: 26rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F1ECE4 25%, #F7F3ED 37%, #F1ECE4 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 16rpx;
}

.sk-title {
  height: 34rpx;
  width: 62%;
}

.sk-a { width: 96%; }
.sk-b { width: 88%; }
.sk-c { width: 40%; margin-bottom: 0; }

@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ---------- 空 / 错误 ---------- */
.sv {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sv-mark {
  width: 92rpx;
  height: 92rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #E3DCD2;
  color: #B54A34;
  font-size: 40rpx;
  margin-bottom: 28rpx;
}

.sv-mark-empty {
  color: #C0B9AE;
  font-size: 52rpx;
  line-height: 72rpx;
}

.sv-text {
  font-size: 27rpx;
  color: #8A9098;
  text-align: center;
  line-height: 1.7;
}

.sv-btn {
  margin-top: 32rpx;
  padding: 16rpx 52rpx;
  border-radius: 999rpx;
  border: 1px solid #D9CFC3;
  font-size: 27rpx;
  color: #B54A34;
}

.sv-btn-hover {
  background-color: #F8ECE7;
}
