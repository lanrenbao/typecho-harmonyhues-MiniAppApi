.cover {
  position: relative;
  height: 330rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #E9E4DC;
}

.cover-img {
  display: block;
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
}

.cover-name {
  position: absolute;
  left: 30rpx;
  bottom: 26rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: "Songti SC", "SimSun", Georgia, serif;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.head {
  padding: 40rpx 40rpx 8rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 600;
  color: #1F2328;
  letter-spacing: 2rpx;
}

/* 统计：三列两行的竖排标题 + 大号数字 */
.stats {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 8rpx 12rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
}

.st {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 26rpx;
}

.st-label {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.st-char {
  font-size: 24rpx;
  line-height: 1.25;
  color: #8C9299;
  letter-spacing: 2rpx;
}

.st-num {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.1;
  font-family: Georgia, "Songti SC", serif;
}

.st-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #A6ADA8;
}

.group {
  margin: 20rpx 24rpx 0;
  padding: 8rpx 26rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  padding: 22rpx 0 14rpx;
  border-bottom: 1rpx solid #F1EDE7;
}

.group-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
  letter-spacing: 1rpx;
}

.group-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #A6ADA8;
}

.group-body {
  padding: 6rpx 0 10rpx;
}

.g-item {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F2EC;
}

.g-item:last-child {
  border-bottom: none;
}

.g-item-hover {
  opacity: 0.62;
}

.g-date {
  flex: none;
  width: 76rpx;
  font-size: 23rpx;
  color: #B0A79C;
  font-family: Georgia, serif;
}

.g-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #2A2F35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.foot-tip {
  padding: 36rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B3ABA1;
  letter-spacing: 1rpx;
}
